# Single-container demo for free hosting (Render): PHP Motors + a bundled MariaDB.
# Data lives inside the container and resets to the sample data on every restart.
# For a persistent setup use the regular Dockerfile + docker-compose.yml.
FROM php:8.3-apache

RUN apt-get update \
 && apt-get install -y --no-install-recommends mariadb-server libjpeg62-turbo-dev libpng-dev libfreetype6-dev \
 && docker-php-ext-configure gd --with-jpeg --with-freetype \
 && docker-php-ext-install -j"$(nproc)" pdo_mysql gd \
 && rm -rf /var/lib/apt/lists/*

COPY docker/php.ini /usr/local/etc/php/conf.d/phpmotors.ini
COPY docker/apache-phpmotors.conf /etc/apache2/conf-enabled/phpmotors.conf
COPY docker/entrypoint.sh /usr/local/bin/phpmotors-entrypoint
COPY docker/render-entrypoint.sh /usr/local/bin/render-entrypoint
COPY docker/seed.php sql/phpmotors.sql /opt/phpmotors/
RUN chmod +x /usr/local/bin/phpmotors-entrypoint /usr/local/bin/render-entrypoint

COPY docker/root-index.php /var/www/html/index.php
COPY . /var/www/html/phpmotors/
RUN chown -R www-data:www-data /var/www/html/phpmotors/images/vehicles

ENV DB_HOST=127.0.0.1 DB_PORT=3306 DB_NAME=phpmotors DB_USER=iClient DB_PASSWORD=phpmotors-demo
ENTRYPOINT ["render-entrypoint"]
CMD ["apache2-foreground"]
